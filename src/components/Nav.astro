---
import { siteConfig } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const target = base + href;
  return currentPath === target || currentPath === target + '/';
};
---

<nav class="site-nav">
  <a href={base + '/'} class="brand-group">
    <img class="nav-logo" src={base + '/favicon.svg'} alt="" width="100" height="100" />
    <span class="brand">{siteConfig.name}</span>
  </a>

  <ul class="nav-links" id="nav-links">
    {siteConfig.nav.map((link) => (
      <li>
        <a
          href={base + link.href}
          class={[isActive(link.href) ? 'active' : '', link.href === '/reservations' ? 'nav-cta' : ''].filter(Boolean).join(' ')}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>

<script>
  const hamburger = document.getElementById('nav-hamburger') as HTMLButtonElement;
  const links     = document.getElementById('nav-links') as HTMLUListElement;

  // Below 1060px the collapsed menu is visually hidden but would otherwise stay
  // in the tab order; above it the links are always visible and must never be inert.
  const collapsible = window.matchMedia('(max-width: 1060px)');
  const syncInert = () => {
    links.toggleAttribute('inert', collapsible.matches && !links.classList.contains('nav-open'));
  };

  hamburger?.addEventListener('click', () => {
    const open = links.classList.toggle('nav-open');
    hamburger.classList.toggle('is-open', open);
    hamburger.setAttribute('aria-expanded', String(open));
    syncInert();
  });

  links?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      links.classList.remove('nav-open');
      hamburger.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      syncInert();
    });
  });

  document.addEventListener('click', (e) => {
    if (!hamburger.contains(e.target as Node) && !links.contains(e.target as Node)) {
      links.classList.remove('nav-open');
      hamburger.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      syncInert();
    }
  });

  collapsible.addEventListener('change', syncInert);
  syncInert();

  const nav = document.querySelector('.site-nav') as HTMLElement;
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 10);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
