---
import { siteConfig } from '../config';
import instagramIcon from '../assets/Instagram/instagram.svg?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer>
  <div class="footer-inner">
    <a href={siteConfig.instagram} class="footer-instagram" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
      <Fragment set:html={instagramIcon} />
    </a>

    <p class="footer-trademark">{siteConfig.name}<span class="footer-tm">™</span></p>

    <nav class="footer-links" aria-label="Footer">
      <a href={base + '/hours'}>Contact</a>
      <a href={base + '/privacy'}>Privacy Policy</a>
    </nav>
  </div>
</footer>
