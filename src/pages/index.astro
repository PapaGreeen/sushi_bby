---
import Layout from '../layouts/Layout.astro';
import ResyButton from '../components/ResyButton.astro';
import { siteConfig } from '../config';
import bar1Image from '../assets/restaurant.jpeg';
import barShot1 from '../assets/hero-image.png';
import sushiImage from '../assets/placeholder/nigiri.png';
import carvingImage from '../assets/Instagram/private-event1.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// schema.org Restaurant structured data. Every value is pulled from config.ts
// or derived from `site`, so it cannot drift from what the pages display.
const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: siteConfig.name,
  url: new URL('/', Astro.site).href,
  image: new URL('/logo.png', Astro.site).href,
  telephone: siteConfig.phoneE164,
  email: siteConfig.email,
  servesCuisine: ['Japanese', 'Sushi', 'Omakase'],
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.addressParts.street,
    addressLocality: siteConfig.addressParts.locality,
    addressRegion: siteConfig.addressParts.region,
    postalCode: siteConfig.addressParts.postalCode,
    addressCountry: siteConfig.addressParts.country,
  },
  openingHours: siteConfig.businessHours.map((entry) => entry.schema),
  sameAs: [siteConfig.instagram],
};

// Escape `<` so the payload can never terminate the script element early.
const restaurantSchemaJson = JSON.stringify(restaurantSchema).replace(/</g, '\\u003c');

const offerings = [
  {
    title: "Omakase",
    description: "A 12 or 17 course experience, curated exclusively for you, by our chefs.",
    image: sushiImage.src,
    imageAlt: "Omakase experience at Sushi BBY",
    href: "/gallery#omakase",
  },
  {
    title: "Private Events",
    description: "Whole bluefin broken down tableside — raw, ceremonial, and unforgettable.",
    image: carvingImage.src,
    imageAlt: "Tableside tuna carving",
    href: "/gallery#private-events",
  },
  {
    title: "The Experience",
    description: "The full counter, just yours. Intimate dining for groups up to seventeen.",
    image: bar1Image.src,
    imageAlt: "Private dining at Sushi BBY",
    href: "/gallery#the-experience",
  },
];
---

<Layout description="Omakase, tuna carvings, and private events at Sushi BBY.">
  <script type="application/ld+json" slot="head" is:inline set:html={restaurantSchemaJson} />

  <!-- Hero — a single static image by design. There is no slideshow, so it
       carries no pause control and no tablist; those were removed rather than
       left to describe a widget that does not exist. -->
  <section class="hero">
    <div class="hero-slide active">
      <img src={barShot1.src} alt="The sushi bar at Sushi BBY" />
    </div>

    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="hero-content">
      <h1>A Chef-Driven<br />Experience</h1>
      <p class="tagline">
        Omakase (お任せ) — "I'll leave it up to you." A multi-course progression
        built entirely around the day's catch. No menu. Trust the chef.
      </p>
      <div class="hero-actions">
        <ResyButton />
        <div class="btn">
          <a href={base + '/reservations'} class="btn-primary">Reservations</a>
          <span></span>
        </div>
      </div>
    </div>

  </section>

  <!-- Signature Offerings -->
  <section class="home-offerings">
    <div class="home-offerings-inner">
      <div class="home-offerings-grid">
        {offerings.map((item) => (
          <a href={base + item.href} class="offering-card anim-fade-up">
            <div class="offering-card-media">
              <img src={item.image} alt={item.imageAlt} />
            </div>
            <div class="offering-card-overlay" aria-hidden="true"></div>
            <div class="offering-card-body">
              <h2>{item.title}</h2>
              <p>{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Reserve CTA Band -->
  <section class="cta-band anim-fade-up">
    <p class="cta-band-heading">Seatings are limited. Reserve yours.</p>
    <div class="btn" style="margin: 1.75rem auto 0;">
      <a href={base + '/reservations'} class="btn-primary">Reserve</a>
      <span></span>
    </div>
  </section>

  <!-- Location strip -->
  <div class="location-strip">
    <a href="https://maps.app.goo.gl/44ThZV9dpDyexThz8" data-address={siteConfig.address}>Scotch Plains, NJ</a>&nbsp;·&nbsp;<a href={base + '/reservations'}>BYOB</a>&nbsp;·&nbsp;<a href={base + '/hours'}>Hours &amp; Location</a>
  </div>

</Layout>

<style>
  .cta-band {
    background: var(--color-bg);
    border-top: 1px solid rgba(196, 168, 130, 0.18);
    padding: 100px var(--pad-x);
    text-align: center;
    position: relative;
  }

  .cta-band::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 2px;
    background: linear-gradient(to right, transparent, var(--color-neon-teal) 30%, var(--color-neon-teal) 70%, transparent);
    opacity: 0.9;
  }

  .cta-band-heading {
    font-size: 1.4rem;
    font-weight: 600;
    color: #fff;
  }

  .location-strip {
    text-align: center;
    padding: 1.25rem var(--pad-x);
    font-size: 0.85rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .location-strip a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .location-strip a:hover {
    text-decoration: underline;
  }
</style>

