---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config';
import barCenteredAiImage from '../assets/placeholder/bar-centered-ai.png';
import bar1Image from '../assets/bar1.jpg';
import barImageAI from '../assets/placeholder/barAI.png';
import sushiImage from '../assets/placeholder/Sushi-placeholder.avif';
import carvingImage from '../assets/Instagram/tuna-carving.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const slides = [
  { src: barCenteredAiImage.src, alt: "Sushi BBY bar" },
  { src: barImageAI.src, alt: "Sushi BBY bar 2" }
];


const offerings = [
  {
    title: "Omakase",
    description: "A 13 course experience. No menu. Trust the chef.",
    image: sushiImage.src,
    imageAlt: "Omakase experience at Sushi BBY",
    href: "/gallery#omakase",
  },
  {
    title: "Private Events",
    description: "Whole bluefin broken down tableside — raw, ceremonial, and unforgettable.",
    image: carvingImage.src,
    imageAlt: "Tableside tuna carving",
    href: "/gallery#private-events",
  },
  {
    title: "The Experience",
    description: "The full counter, just yours. Intimate dining for groups up to twelve.",
    image: bar1Image.src,
    imageAlt: "Private dining at Sushi BBY",
    href: "/gallery#the-experience",
  },
];
---

<Layout description="Omakase, tuna carvings, and private events at Sushi BBY.">
  <!-- Hero -->
  <section class="hero">
    {slides.map((slide, i) => (
      <div class={`hero-slide${i === 0 ? ' active' : ''}`}>
        <img src={slide.src} alt={slide.alt} />
      </div>
    ))}

    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="hero-content">
      <h1>A Chef-Driven<br />Experience</h1>
      <p class="tagline">
        Omakase (お任せ) — "I'll leave it up to you." A multi-course progression
        built entirely around the day's catch. No menu. Trust the chef.
      </p>
      <div class="hero-actions">
        <div class="btn">
          <a href={base + '/reservations'} class="btn-primary">Reservations</a>
          <span></span>
        </div>
      </div>
    </div>

    <div class="hero-controls">
      <button class="hero-pause" aria-label="Pause slideshow" id="hero-pause">
        <svg class="icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <rect x="3" y="2" width="3.5" height="12" rx="1"/>
          <rect x="9.5" y="2" width="3.5" height="12" rx="1"/>
        </svg>
        <svg class="icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <polygon points="3,1 13,8 3,15"/>
        </svg>
      </button>
      <div class="hero-dots" role="tablist" aria-label="Slideshow navigation">
        {slides.map((_, i) => (
          <button
            class={`hero-dot${i === 0 ? ' active' : ''}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Slide ${i + 1}`}
            data-slide={String(i)}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- Signature Offerings -->
  <section class="home-offerings">
    <div class="home-offerings-inner">
      <div class="home-offerings-grid">
        {offerings.map((item) => (
          <a href={base + item.href} class="offering-card anim-fade-up">
            <div class="offering-card-media">
              <img src={item.image} alt={item.imageAlt} />
            </div>
            <div class="offering-card-overlay" aria-hidden="true"></div>
            <div class="offering-card-body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Reserve CTA Band -->
  <section class="cta-band anim-fade-up">
    <p class="cta-band-heading">Seatings are limited. Reserve yours.</p>
    <div class="btn" style="margin: 1.75rem auto 0;">
      <a href={base + '/reservations'} class="btn-primary">Reserve</a>
      <span></span>
    </div>
  </section>

  <!-- Location strip -->
  <div class="location-strip">
    <a href="https://maps.app.goo.gl/44ThZV9dpDyexThz8">{siteConfig.address}</a>
    &nbsp;·&nbsp;
    <a href={base + '/hours'}>Hours &amp; Location</a>
  </div>

</Layout>

<style>
  .cta-band {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding: 100px var(--pad-x);
    text-align: center;
  }

  .cta-band-heading {
    font-size: 1.4rem;
    font-weight: 600;
    color: #fff;
  }

  .location-strip {
    text-align: center;
    padding: 1.25rem var(--pad-x);
    font-size: 0.85rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .location-strip a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .location-strip a:hover {
    text-decoration: underline;
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.hero-dot'));
  const pauseBtn = document.getElementById('hero-pause') as HTMLButtonElement | null;

  let current = 0;
  let paused = false;

  function goTo(index: number) {
    slides[current].classList.remove('active');
    dots[current]?.classList.remove('active');
    dots[current]?.setAttribute('aria-selected', 'false');
    current = ((index % slides.length) + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current]?.classList.add('active');
    dots[current]?.setAttribute('aria-selected', 'true');
  }

  if (slides.length > 1) {
    setInterval(() => { if (!paused) goTo(current + 1); }, 6000);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => goTo(i));
  });

  pauseBtn?.addEventListener('click', () => {
    paused = !paused;
    pauseBtn.classList.toggle('is-paused', paused);
    pauseBtn.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
  });

</script>
