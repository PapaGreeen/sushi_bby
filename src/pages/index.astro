---
import Layout from '../layouts/Layout.astro';
import restaurantImg from '../assets/restaurant.jpeg';
import restaurantImgMobile from '../assets/restaurant.png';

// span: "wide" = 2 cols, "tall" = 2 rows, "feature" = 2×2, default = 1×1
const shots = [
  { alt: "Omakase opening course",      span: "feature" },
  { alt: "Bluefin nigiri close-up",     span: "wide"    },
  { alt: "Chef at the counter",         span: ""        },
  { alt: "Salmon nigiri",               span: ""        },
  { alt: "Interior — bar seating",      span: "tall"    },
  { alt: "Uni nigiri",                  span: ""        },
  { alt: "Spicy tuna crispy rice",      span: ""        },
  { alt: "Whole tuna on ice",           span: "wide"    },
  { alt: "House sake selection",        span: ""        },
  { alt: "Evening service",             span: ""        },
];
---

<Layout description="Omakase, tuna carvings, and private events at Sushi BBY.">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <h1>A Chef-Driven<br />Experience</h1>
      <p class="tagline">
        Omakase (お任せ) — "I'll leave it up to you." A multi-course progression
        built entirely around the day's catch. No menu. Trust the chef.
      </p>
      <div class="hero-actions">
        <div class="btn">
          <a href="/reservations" class="btn-primary">Reservations</a>
          <span></span>
        </div>
      </div>
    </div>
    <div class="hero-media">
      <picture>
        <source media="(max-width: 1024px)" srcset={restaurantImgMobile.src} />
        <img src={restaurantImg.src} alt="Sushi BBY restaurant" />
      </picture>
    </div>
  </section>

  <!-- Bento Gallery -->
  <section class="gallery home-gallery">
    <div class="gallery-grid">
      {shots.map((shot) => (
        <div class={`gallery-item${shot.span ? ` gallery-item--${shot.span}` : ''}`}>
          <!--
            Replace with: <img src="/images/home/filename.jpg" alt={shot.alt} />
            Sizes: 1200×1200 square · 2400×1200 wide · 1200×2400 tall · 2400×2400 feature
          -->
          <div class="gallery-placeholder" aria-label={shot.alt}>
            <span>{shot.alt}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
