---
import Layout from '../layouts/Layout.astro';
---

<Layout description="Omakase, tuna carvings, and private events at Sushi BBY.">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow">Welcome to Sushi BBY</p>
      <h1>A Chef-Driven<br />Sushi Experience</h1>
      <p class="tagline">
        Omakase seatings, whole tuna carvings, and private dining —
        each one shaped by what's freshest that day.
      </p>
      <div class="hero-actions">
        <a href="/reservations" class="btn btn-primary">Reserve a Table</a>
        <a href="/menu" class="btn btn-secondary">View Menu</a>
      </div>
    </div>
    <div class="hero-media">
      <!-- Replace with a full hero image: <img src="/images/hero.jpg" alt="Omakase plate at Sushi BBY" /> -->
      <div class="media-placeholder" aria-hidden="true">Hero Image</div>
    </div>
  </section>

  <!-- The Concept -->
  <section class="experience-concept">
    <div class="concept-text">
      <h2>The Experience</h2>
      <p>
        Every seat at Sushi BBY is an opportunity to eat well. Whether you're
        dropping in for a couple of rolls at the bar or sitting down for a
        full omakase, the same care goes into every plate.
      </p>
      <p>
        We don't run a frozen fish program. Everything is sourced daily, prepared
        to order, and served the way it was meant to be eaten — simply, and at
        the right temperature.
      </p>
    </div>
    <div class="concept-media">
      <!-- Replace with image: <img src="/images/concept.jpg" alt="Chef at work" /> -->
      <div class="media-placeholder" aria-hidden="true">Image Placeholder</div>
    </div>
  </section>

  <!-- Signature Offerings -->
  <section class="experience-offerings">
    <h2>What We Offer</h2>
    <div class="offerings-grid">
      <article class="offering-card">
        <div class="offering-media">
          <!-- <img src="/images/omakase.jpg" alt="Omakase course" /> -->
          <div class="media-placeholder" aria-hidden="true">Image Placeholder</div>
        </div>
        <div class="offering-body">
          <h3>Omakase</h3>
          <p>
            Trust the chef. Our omakase courses run 8–12 pieces and change
            nightly based on the catch. Reservations required.
          </p>
          <a href="/reservations" class="btn btn-primary">Book Omakase</a>
        </div>
      </article>
      <article class="offering-card">
        <div class="offering-media">
          <!-- <img src="/images/tuna.jpg" alt="Whole tuna carving" /> -->
          <div class="media-placeholder" aria-hidden="true">Image Placeholder</div>
        </div>
        <div class="offering-body">
          <h3>Tuna Carving</h3>
          <p>
            A whole bluefin broken down tableside and served as nigiri and
            sashimi for the group. Minimum 4 guests. Inquire for dates.
          </p>
          <a href="/reservations" class="btn btn-primary">Inquire</a>
        </div>
      </article>
      <article class="offering-card">
        <div class="offering-media">
          <!-- <img src="/images/private.jpg" alt="Private dining room" /> -->
          <div class="media-placeholder" aria-hidden="true">Image Placeholder</div>
        </div>
        <div class="offering-body">
          <h3>Private Events</h3>
          <p>
            Intimate dinners and full venue buyouts with a custom menu
            consultation. Suitable for groups of 6 to 40 guests.
          </p>
          <a href="/reservations" class="btn btn-primary">Plan an Event</a>
        </div>
      </article>
    </div>
  </section>

  <!-- Chef Callout -->
  <section class="experience-chef">
    <div class="chef-callout-media">
      <!-- <img src="/images/chef-portrait.jpg" alt="Chef Carmen" /> -->
      <div class="media-placeholder" aria-hidden="true">Chef Portrait</div>
    </div>
    <div class="chef-callout-text">
      <p class="callout-label">Meet the Chef</p>
      <h2>Chef Carmen</h2>
      <p>
        With over 15 years of training in Tokyo and New York, Chef Carmen leads
        the kitchen with a focus on seasonal sourcing and traditional technique.
        Every menu is a direct reflection of what's at the market that morning.
      </p>
      <a href="/chef" class="btn btn-primary">Chef's Story</a>
    </div>
  </section>
</Layout>
