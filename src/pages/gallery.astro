---
import Layout from '../layouts/Layout.astro';

const inHouse = [
  { alt: "Omakase course — bluefin nigiri" },
  { alt: "Salmon nigiri close-up" },
  { alt: "House sake selection" },
  { alt: "Spicy tuna crispy rice" },
  { alt: "Uni nigiri" },
  { alt: "Interior — bar seating" },
  { alt: "Gyoza with ponzu" },
  { alt: "Omakase platter" },
  { alt: "Chef's hands — knife work" },
  { alt: "Dining room — evening service" },
  { alt: "Whole bluefin on ice" },
  { alt: "Sushi BBY counter" },
];

const privateEvents = [
  { alt: "Tuna carving tableside" },
  { alt: "Private dining setup" },
  { alt: "Chef Carmen at the counter" },
  { alt: "Event setup — full counter" },
  { alt: "Group dining" },
  { alt: "Tuna on ice" },
];
---

<Layout title="Gallery" description="Photos from Sushi BBY — food, events, and the restaurant.">
  <section class="page-header anim-fade-up">
    <h1>Gallery</h1>
    <p>
      A look inside the restaurant — our food, our events, and the people
      behind them.
    </p>
  </section>

  <div class="gallery-tabs">
    <button class="gallery-tab active" data-section="inhouse">In House</button>
    <button class="gallery-tab" data-section="private">Private Events</button>
  </div>

  <section class="gallery-section" id="gallery-inhouse">
    <div class="gallery-new-grid anim-fade-up">
      {inHouse.map((photo) => (
        <div class="gallery-new-item">
          <div class="gallery-new-placeholder" aria-label={photo.alt}>
            <span>{photo.alt}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="gallery-section hidden" id="gallery-private">
    <div class="gallery-new-grid">
      {privateEvents.map((photo) => (
        <div class="gallery-new-item">
          <div class="gallery-new-placeholder" aria-label={photo.alt}>
            <span>{photo.alt}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.gallery-tab');
  const sections = document.querySelectorAll<HTMLElement>('.gallery-section');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      if (tab.classList.contains('active')) return;
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const targetId = 'gallery-' + tab.dataset.section;
      sections.forEach(s => {
        if (s.id === targetId) {
          s.classList.remove('hidden');
          s.classList.add('section-enter');
          s.addEventListener('animationend', () => s.classList.remove('section-enter'), { once: true });
        } else {
          s.classList.add('hidden');
        }
      });
    });
  });
</script>
