---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config';
---

<Layout title="Hours & Location" description="Find Sushi BBY — address, hours, and how to get here.">
  <section class="page-header">
    <h1>Hours & Location</h1>
    <p>
      We're open most days of the week. Walk-ins welcome based on availability.
      Reservations recommended for omakase and weekend evenings.
    </p>
  </section>

  <section class="hours-location">
    <!-- Map -->
    <div class="hours-map">
      <!--
        Replace with a Google Maps embed:
        <iframe src="https://maps.google.com/..." ...></iframe>
      -->
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3027.1354838908796!2d-74.39940228694472!3d40.648943771283854!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c3b085ccdb14b5%3A0x3c9dbfeacd1cdd55!2s1832%20E%202nd%20St%2C%20Scotch%20Plains%2C%20NJ%2007076!5e0!3m2!1sen!2sus!4v1779760593011!5m2!1sen!2sus"
        width="100%" height="400" style="border:0; display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>

    <!-- Info -->
    <div class="hours-info">
      <div class="info-block">
        <h2>Address</h2>
        <address>
          {siteConfig.address}<br />
          <!-- Add neighborhood or cross-street if helpful -->
        </address>
      </div>

      <div class="info-block">
        <h2>Hours</h2>
        <ul class="hours-list">
          {siteConfig.hours.map((entry) => (
            <li>
              <span>{entry.day}</span>
              <span>{entry.time}</span>
            </li>
          ))}
        </ul>
        <p class="hours-note">
          Kitchen closes 30 minutes before listed closing time. Hours may vary
          on holidays — follow us on social or call ahead to confirm.
        </p>
      </div>

      <div class="info-block">
        <h2>Contact</h2>
        <p><a href={`tel:${siteConfig.phone}`}>{siteConfig.phone}</a></p>
        <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
      </div>

      <div class="info-block">
        <h2>Getting Here</h2>
        <p>
          <strong>Parking:</strong> Street parking available on Lorem and Ipsum
          Streets. Paid lot one block north on Dolor Ave.
        </p>
        <p>
          <strong>Transit:</strong> Nearest stop is Lorem Station, two blocks
          west. Bus lines 00 and 00X stop directly in front.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Make the Google Maps iframe fully responsive */
  .hours-map iframe {
    width: 100%;
    height: 400px;
    display: block;
    border-radius: var(--radius-md);
    position: sticky;
    top: 80px;
  }

  @media (max-width: 768px) {
    .hours-map iframe {
      position: static;
      height: 260px;
    }
  }
</style>
