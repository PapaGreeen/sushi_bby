---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    name: "Starters",
    items: [
      { name: "Edamame", description: "Steamed salted soybeans, served warm.", price: "$5" },
      { name: "Miso Soup", description: "House dashi broth, tofu, wakame, scallion.", price: "$4" },
      { name: "Gyoza", description: "Pan-fried pork and cabbage dumplings, ponzu dipping sauce.", price: "$9" },
      { name: "Tuna Tataki", description: "Seared albacore, ginger ponzu, crispy shallots, microgreens.", price: "$16" },
    ],
  },
  {
    name: "Nigiri & Sashimi",
    items: [
      { name: "Bluefin Tuna", description: "Two pieces nigiri. Market availability.", price: "$12" },
      { name: "Yellowtail", description: "Two pieces nigiri, yuzu zest.", price: "$10" },
      { name: "Salmon", description: "Two pieces nigiri. Wild-caught or farm-raised as available.", price: "$9" },
      { name: "Uni", description: "Sea urchin on seasoned rice. Market availability.", price: "$16" },
      { name: "Sashimi Platter", description: "Chef's selection of 12 pieces. Seasonal cuts only.", price: "$38" },
    ],
  },
  {
    name: "Signature Rolls",
    items: [
      { name: "The BBY Roll", description: "Spicy tuna, avocado, cucumber, topped with bluefin and jalapeño.", price: "$22" },
      { name: "Tuna Carving Roll", description: "Fatty tuna, shiso, pickled daikon, house carving sauce.", price: "$26" },
      { name: "Crispy Rice Spicy Tuna", description: "Seared rice cake, spicy tuna, sriracha aioli, scallion.", price: "$19" },
      { name: "Vegetable Roll", description: "Seasonal vegetables, avocado, sesame, light soy glaze.", price: "$13" },
    ],
  },
  {
    name: "Omakase",
    items: [
      { name: "8-Course Omakase", description: "Seasonal nigiri and small plates composed by the chef. Changes nightly. Reservations required.", price: "$95 / person" },
      { name: "12-Course Omakase", description: "Full chef's progression including rare cuts and a dessert course. Reservations required.", price: "$145 / person" },
      { name: "Tuna Carving Experience", description: "Whole bluefin breakdown at the table, served as nigiri and sashimi for the group. Minimum 4 guests.", price: "Market price" },
    ],
  },
  {
    name: "Drinks",
    items: [
      { name: "Sake — House", description: "Rotating selection of junmai and junmai ginjo.", price: "$9 / glass" },
      { name: "Sake — Premium", description: "Ask your server for the current bottle list.", price: "Varies" },
      { name: "Japanese Whisky", description: "Curated selection. Ask your server.", price: "Varies" },
      { name: "Non-Alcoholic", description: "Still and sparkling water, house-made iced green tea, soft drinks.", price: "$4–$6" },
    ],
  },
];
---

<Layout title="Menu" description="Browse the Sushi BBY menu — nigiri, rolls, omakase, and more.">
  <section class="page-header">
    <h1>Menu</h1>
    <p>
      Our menu changes with the season and daily catch. Prices and availability
      may vary. Ask your server about current specials and omakase availability.
    </p>
  </section>

  <section class="menu">
    {categories.map((category) => (
      <div class="menu-category">
        <h2>{category.name}</h2>
        <ul class="menu-items">
          {category.items.map((item) => (
            <li class="menu-item">
              <div class="menu-item-info">
                <h3>{item.name}</h3>
                <p>{item.description}</p>
              </div>
              <span class="menu-item-price">{item.price}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Layout>
