---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config';
---

<Layout title="Reservations" description="Reserve a seat at Sushi BBY's omakase experience.">
  <section class="res-simple">
    <div class="res-simple-inner">

      <div class="res-block anim-fade-up">
        <h1>Reservations</h1>
        <p>
          Sushi BBY is an omakase-only counter. Every seating is built around
          raw fish and rice — there are no vegan substitutions, riceless options,
          or fish-free alternatives.
        </p>
      </div>

      <div class="res-seating anim-fade-up">
        <h2>Seatings</h2>
        <p>Tuesday – Thursday: 6:00 pm · 8:00 pm</p>
        <p>Friday – Saturday: 5:00 pm · 7:00 pm · 9:00 pm</p>
        <p class="res-note">
          Each seating runs approximately 1 hour and 45 minutes. Out of respect
          for all guests, we ask that you arrive on time. A 10-minute grace
          period is observed — guests arriving after that point may not receive
          the full omakase progression.
        </p>
      </div>

      <div class="res-block anim-fade-up">
        <h2>Pricing</h2>
        <p>Omakase is $110 per person, plus tax.</p>
      </div>

      <div class="res-block anim-fade-up">
        <h2>Cancellation Policy</h2>
        <p>
          Cancellations made within 24 hours of your reservation — for any
          reason — are charged at 100% per person.
        </p>
      </div>

      <div class="res-block anim-fade-up">
        <h2>Reservations</h2>
        <p>
          Book through <strong>Resy</strong>.
          For group inquiries or questions, reach us at{' '}
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
        </p>
      </div>

    </div>
  </section>
</Layout>

<style>
  .res-simple {
    padding: 5rem var(--pad-x);
    display: flex;
    justify-content: center;
  }

  .res-simple-inner {
    max-width: 560px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .res-block {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .res-simple-inner h1 {
    font-size: 2.25rem;
    margin: 0;
  }

  .res-simple-inner h2 {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-subtle);
    margin: 0;
  }

  .res-seating {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .res-simple-inner p {
    color: var(--color-muted);
    margin: 0;
  }

  .res-note {
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }

  .res-simple-inner a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
